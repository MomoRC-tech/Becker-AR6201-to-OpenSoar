	(text "Jumper at 5 V. Output leads pass the ferrite."
		(exclude_from_sim no)
		(at 114.3 41.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "06b5cbcd-5ed9-4576-8a7f-cfcc11f5620e")
	)
	(text "Built as a chain: ESP32 -> mod2 R3/R4 -> mod1.\nL2-R3 and L1-R4 are joined on each board,\nso mod2 L2 (R-D) is on 3V3."
		(exclude_from_sim no)
		(at 101.6 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "35e17aee-fbf3-4b3c-a683-ec0494bc27b8")
	)
	(text "Supply voltage sense (step 3d): R-V1 at the XT30 + cup,\nR-V2 and C-V at ESP32 J2-5 / J2-14. GPIO34 = 12V-IN / 11."
		(exclude_from_sim no)
		(at 180.34 58.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36705518-5cdc-45a4-942f-1a2dfa19491b")
	)
	(text "ESP32 TX (GPIO17) -> TXD = DI (IC pin 3)\nESP32 RX (GPIO16) <- divider <- RXD = RO (IC pin 2)\n120 ohm receive termination on A/B."
		(exclude_from_sim no)
		(at 182.88 246.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "43f5ff59-ea6e-417d-b964-1394112f6f93")
	)
	(text "RX divider R-B1 / R-B2:\nRO 5 V -> GPIO16 about 3 V"
		(exclude_from_sim no)
		(at 238.76 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "477afcdc-d118-40e4-92b2-c0f3c1706fa6")
	)
	(text "DE-9 cups 3, 6, 7 bridged; one wire to GND-J.\nPairs 4/5 and 8/9 twisted. Becker shield\nto J1-11 at the radio end only."
		(exclude_from_sim no)
		(at 25.4 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7374abc7-aa7b-4e98-bbca-16c2af771d07")
	)
	(text "Derived view of docs/hardware/wiring.md and docs/hardware/power.md (ADR-06).\nOn a mismatch the pin tables win. Wiring only: no footprints, no PCB."
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "886b35bf-34f0-4259-9b0b-3cd739f184af")
	)
	(text "12 V harness with fuse F1 at its supply end.\nUBEC IN- also has its own wire to the\ncommon ground point (radio P1-13/25)."
